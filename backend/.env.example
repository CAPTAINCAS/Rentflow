# HTTP / runtime
# APP_ENV: development | production. Production enables fail-closed checks for
# secrets, TLS and cookies.
APP_ENV=development

# Port the API listens on. Managed hosts usually inject this; 3000 is the
# project default and matches the Docker image and health check.
PORT=3000

# PostgreSQL connection string. Local Compose uses the bundled postgres service.
# Managed PostgreSQL must use sslmode=require (or stricter) outside development.
DATABASE_URL=postgres://rentflow:change-me@localhost:5432/rentflow?sslmode=disable

# Optional: directory holding the checked-in migrations. Defaults to
# /app/migrations when present (Docker image), otherwise ./migrations.
MIGRATIONS_DIR=

# WEB_ORIGIN selects the deployment shape. Leave it EMPTY for an API-only
# service (Vercel/Railway/Render hosting the API while Next.js is deployed
# separately). Set it only for the single-container gateway image, where this
# process also reverse-proxies page requests to the Next.js server, e.g.
# WEB_ORIGIN=http://127.0.0.1:3001
WEB_ORIGIN=

# Public origin of the deployed frontend. Used to build password-reset links.
PUBLIC_APP_URL=http://127.0.0.1:3000

# Authentication. Generate with: openssl rand -base64 48
# Must be at least 32 characters; the API refuses to start otherwise.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cookies. Keep true in production so session cookies are sent as
# SameSite=None; Secure (required for cross-origin frontend/API deployments).
# Use false only for plain-HTTP local development.
COOKIE_SECURE=false
# Leave empty unless cookies must be scoped to a parent domain, e.g. .example.com
COOKIE_DOMAIN=

# Payments are sandbox-only. No live-money mode is implemented.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace-me
MPESA_CONSUMER_SECRET=replace-me
MPESA_SHORTCODE=replace-me
MPESA_PASSKEY=replace-me
MPESA_CALLBACK_URL=https://example.invalid/api/v1/mpesa/stk-callback
MPESA_C2B_VALIDATION_URL=https://example.invalid/api/v1/mpesa/c2b-validation
MPESA_C2B_CONFIRMATION_URL=https://example.invalid/api/v1/mpesa/c2b-confirmation
# Use a random value of at least 32 characters and append ?token=<same-value> to each callback URL.
MPESA_CALLBACK_TOKEN=replace-with-a-random-callback-token-of-at-least-32-characters

# Default is mock: no outbound SMS is sent unless provider=africastalking is explicit.
SMS_PROVIDER=mock
AFRICASTALKING_BASE_URL=https://api.sandbox.africastalking.com
AFRICASTALKING_USERNAME=replace-me
AFRICASTALKING_API_KEY=replace-me
AFRICASTALKING_SENDER_ID=
