# Frontend environment (Vercel: Settings → Environment Variables)
#
# Leave NEXT_PUBLIC_API_BASE_URL empty when the frontend and API are served from
# the same origin (the Docker image gateway, or a Vercel rewrite that proxies
# /api/v1/* to the API service). Browser requests then use relative
# /api/v1/* paths and the session cookies stay first-party.
#
# Set it only when the API is deployed on a different origin, for example
# https://rentflow-api.up.railway.app — no trailing slash, no /api/v1 suffix.
NEXT_PUBLIC_API_BASE_URL=

# Public origin of this frontend. Used by the backend to build password-reset
# links (PUBLIC_APP_URL on the API) and must match this deployment's domain.
NEXT_PUBLIC_SITE_URL=